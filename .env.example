# LLM gateway (app/llm/client.py) — two tiers, each an ordered chain of
# OpenAI-compatible endpoints. No provider is named in code: a provider is only ever a
# base URL and a model string. Leave these empty and every tier reports "unavailable",
# which callers treat as "no model ran" — the deterministic path answers instead.
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=8
# Worst case is LLM_TIMEOUT_SECONDS x chain length; this caps the whole chain.
LLM_TOTAL_TIMEOUT_SECONDS=20

# Small tier — routing, understanding, tone, chit-chat, simple answers.
SMALL_LLM_MODEL=
SMALL_LLM_BASE_URL=
SMALL_LLM_KEY=
# Ordered fallbacks, tried in order. Scanning stops at the first gap, so number them
# from 1 with no holes. Add _2, _3, ... as needed.
SMALL_LLM_FALLBACK_1_MODEL=
SMALL_LLM_FALLBACK_1_BASE_URL=
SMALL_LLM_FALLBACK_1_KEY=

# Big tier — complex multi-step reasoning only, woken by a deterministic trigger.
BIG_LLM_MODEL=
BIG_LLM_BASE_URL=
BIG_LLM_KEY=
BIG_LLM_FALLBACK_1_MODEL=
BIG_LLM_FALLBACK_1_BASE_URL=
BIG_LLM_FALLBACK_1_KEY=

# Explanation prose tone — a prompt-level instruction, not a verified gate. Editable any
# time with no code change.
WEATHERGPT_EXPLANATION_TONE=clear, neutral, and helpful — not overly casual, not overly formal

# Optional data sources — all optional, adapters report "unavailable" if missing
IMD_API_BASE=https://api.data.gov.in
IMD_API_KEY=
CAP_FEED_URL=

# Primary geocoder (app/services/location_resolver/providers/geoapify.py). Empty means
# the existing keyless chain (Open-Meteo, Nominatim) is used exactly as before this
# provider existed — no behavior change without a key.
GEOAPIFY_API_KEY=

# Fallback marine source (app/adapters/stormglass_adapter.py) — only used when the
# keyless OPEN_METEO_MARINE source yields nothing. Empty means marine data comes from
# Open-Meteo Marine alone.
STORMGLASS_API_KEY=

# kaggle_kernel_m2/train_m2.py — Hugging Face checkpoint upload (optional; training
# still runs and checkpoints locally without these). Kaggle Secrets named HF_TOKEN,
# HF_TOKEN_2, HUGGINGFACE_TOKEN, or HF_API_TOKEN are all tried automatically.
HF_TOKEN=
HF_REPO_ID=

# Server-to-server auth (app/services/auth.py) — one or a few keys for the trusted
# backend caller(s) of this microservice, comma-separated. Empty/unset disables the
# gate entirely (dev/test default). Send as `Authorization: Bearer <key>`.
WEATHERGPT_API_KEYS=

# App runtime config (app/config.py) — all optional, defaults shown
WEATHERGPT_ENV=development
WEATHERGPT_DB_PATH=weathergpt.db
WEATHERGPT_REQUEST_MAX_BYTES=65536
WEATHERGPT_CONTEXT_MAX_FACTS_PER_USER=256
WEATHERGPT_CONTEXT_VALUE_MAX_CHARS=4096
WEATHERGPT_SOURCE_TIMEOUT_SECONDS=8
WEATHERGPT_GUARDRAIL_CACHE_TTL_SECONDS=3600
WEATHERGPT_GUARDRAIL_CACHE_MAX_ENTRIES=2048
WEATHERGPT_SOURCE_RETRIES=1
WEATHERGPT_FORECAST_CACHE_TTL_SECONDS=900
WEATHERGPT_LOCATION_CACHE_TTL_SECONDS=2592000
WEATHERGPT_CORS_ORIGINS=
